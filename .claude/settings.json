{
  "permissions": {
    "ask": [
      "Bash(npm run db:sync-prod*)",
      "Bash(npm run db:export-postgres*)",
      "Bash(*sync-local-to-prod*)",
      "Bash(*export-local-to-postgres*)",
      "PowerShell(npm run db:sync-prod*)",
      "PowerShell(npm run db:export-postgres*)",
      "PowerShell(*sync-local-to-prod*)",
      "PowerShell(*export-local-to-postgres*)"
    ],
    "deny": ["Read(./.env.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-local-db.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-on-stop.mjs\"", "timeout": 180 }
        ]
      }
    ]
  }
}
