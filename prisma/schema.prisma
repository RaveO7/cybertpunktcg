generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte. La session est un cookie httpOnly renouvelé à chaque ouverture.
model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  username      String?        @unique
  displayName   String         @default("Ma collection")
  passwordHash  String?
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         CollectionItem[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  collectionShare CollectionShare?
  portfolioHistory PortfolioHistoryCache[]
  wishlist      WishlistItem[]
  decks         Deck[]
  tournamentRoles   TournamentOrganizer[]
  tournamentPlayers TournamentPlayer[]
}

/// Lien secret pour consulter le classeur en lecture seule (sans compte).
model CollectionShare {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Identité OAuth (Google, Apple). Un compte peut avoir un mot de passe et/ou des providers.
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Jeton de session. Seul son empreinte est stockée. Le cookie dure 400 jours
/// et est prolongé à chaque ouverture de l'application.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Compteur du limiteur de débit, partagé entre toutes les instances (clé = portée:IP).
/// Les lignes expirées sont purgées par le cron quotidien.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Statut des tâches planifiées (ex. import des prix) pour détecter les échecs répétés.
model JobStatus {
  name                String    @id
  lastRunAt           DateTime
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
}

/// Extension officielle. Le code vient de la base (ex. welcometonightcityretail).
/// `number` reste vide tant qu'aucun numéro d'extension officiel n'est publié.
model Set {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  number       Int?
  releaseDate  DateTime?
  logoUrl      String?
  description  String?
  cardCount    Int        @default(0)
  status       String     @default("available")
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  printings    Printing[]
}

/// Identité de jeu. Les tirages physiques sont dans Printing.
model Card {
  id                String        @id @default(cuid())
  externalId        String        @unique
  code              String        @unique
  slug              String        @unique
  name              String
  subname           String?
  displayName       String
  canonicalName     String
  canonicalBaseName String?
  rulesText         String?
  officialRulesText String?
  flavorText        String?
  language          String        @default("en")
  color             String?
  cardType          String?
  isEddiable        Boolean?
  cost              Int?
  power             Int?
  ram               Int?
  legality          String?
  rulingsJson       String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tags              CardTag[]
  keywords          CardKeyword[]
  printings         Printing[]
  deckCards         DeckCard[]

  @@index([color])
  @@index([cardType])
}

model CardTag {
  cardId String
  tag    String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, tag])
}

model CardKeyword {
  cardId  String
  keyword String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, keyword])
}

/// Tirage imprimable : set + numéro + langue. externalId sert de clé stable
/// pour un futur scan. officialFinish est le champ officiel (souvent vide).
model Printing {
  id                String           @id @default(cuid())
  externalId        String           @unique
  cardId            String
  setId             String
  collectorNumber   String
  rarity            String?
  imagePath         String?
  sourceImageUrl    String?
  artist            String?
  language          String           @default("en")
  localizedName     String?
  printedRulesText  String?
  officialRulesText String?
  officialFinish    String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  card              Card             @relation(fields: [cardId], references: [id], onDelete: Restrict)
  set               Set              @relation(fields: [setId], references: [id], onDelete: Restrict)
  items             CollectionItem[]
  prices            Price[]
  snapshots         PriceSnapshot[]
  wishlistItems     WishlistItem[]

  @@unique([setId, collectorNumber, language])
  @@index([cardId])
  @@index([collectorNumber])
  @@index([rarity])
}

model Condition {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  sortOrder Int
  isActive  Boolean          @default(true)
  items     CollectionItem[]
  prices    Price[]
}

model CollectionItem {
  id               String    @id @default(cuid())
  userId           String
  printingId       String
  conditionId      String
  quantity         Int
  notes            String?
  purchasePrice    Decimal?
  purchaseCurrency String?
  addedAt          DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  printing         Printing  @relation(fields: [printingId], references: [id], onDelete: Restrict)
  condition        Condition @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  @@unique([userId, printingId, conditionId])
  @@index([userId])
  @@index([printingId])
}

/// Carte souhaitée, avec un prix cible optionnel (EUR, comparé au prix tendance Cardmarket).
/// `alertAt` est posé quand le prix passe sous la cible (cron quotidien des prix) et effacé
/// quand il repasse au-dessus ; `alertSeen` vaut false tant que l'utilisateur n'a pas vu l'alerte.
model WishlistItem {
  id          String    @id @default(cuid())
  userId      String
  printingId  String
  targetPrice Decimal?
  notes       String?
  alertAt     DateTime?
  alertPrice  Decimal?
  alertSeen   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  printing    Printing  @relation(fields: [printingId], references: [id], onDelete: Cascade)

  @@unique([userId, printingId])
  @@index([printingId])
}

/// Deck construit par l'utilisateur. Les cartes sont des identités de jeu (Card), pas des tirages :
/// la possession compte tous les tirages de la carte. Un deck peut être incomplet ou illégal
/// (brouillon) ; la validité est calculée à l'affichage (src/lib/deck.ts).
model Deck {
  id        String     @id @default(cuid())
  userId    String
  name      String
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     DeckCard[]

  @@index([userId])
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
  @@index([cardId])
}

model PriceSource {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  /// Date `createdAt` du dernier guide de prix importé (évite d'importer deux fois le même).
  guideCreatedAt DateTime?
  prices    Price[]
  snapshots PriceSnapshot[]
}

/// Prix de marché importé. `kind` vaut `trend` pour le prix tendance Cardmarket.
/// `previousAmount` conserve le montant avant le dernier changement (flèches hausse/baisse).
model Price {
  id             String      @id @default(cuid())
  printingId     String
  conditionId    String?
  sourceId       String
  kind           String
  amount         Decimal
  previousAmount Decimal?
  currency       String      @default("EUR")
  updatedAt      DateTime    @updatedAt
  printing       Printing    @relation(fields: [printingId], references: [id], onDelete: Cascade)
  condition      Condition?  @relation(fields: [conditionId], references: [id])
  source         PriceSource @relation(fields: [sourceId], references: [id])

  @@index([printingId])
}

/// Point d'historique Cardmarket (un snapshot par jour et par printing).
model PriceSnapshot {
  id         String      @id @default(cuid())
  printingId String
  sourceId   String
  kind       String
  amount     Decimal
  currency   String      @default("EUR")
  day        DateTime
  createdAt  DateTime    @default(now())
  printing   Printing    @relation(fields: [printingId], references: [id], onDelete: Cascade)
  source     PriceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([printingId, sourceId, kind, day])
  @@index([day])
  @@index([printingId, day])
}

/// Courbe de valeur du portefeuille déjà calculée, par utilisateur et par filtre
/// (`scope` = set|langue). Ne contient que les jours « figés » (<= J-2) ; les jours
/// récents sont recalculés à chaque lecture. `fingerprint` résume la collection
/// filtrée : s'il change, tout est recalculé.
model PortfolioHistoryCache {
  userId          String
  scope           String
  fingerprint     String
  lastDay         String?
  lastPricesJson  String
  pointsJson      String
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope])
}

/// Tournoi (rondes suisses puis top cut optionnel). Aucune relation directe vers User : les
/// organisateurs sont des lignes TournamentOrganizer, pour qu'une suppression de compte ne
/// supprime jamais un tournoi ni ses résultats. Les états sont des chaînes (pas d'enum : SQLite).
/// `revision` est incrémentée à chaque écriture (sondage des écrans, cf. src/lib/tournament).
model Tournament {
  id                    String                @id @default(cuid())
  code                  String                @unique
  name                  String
  /// boutique | competitif
  format                String                @default("boutique")
  /// bo1 | bo3
  matchType             String                @default("bo3")
  roundMinutes          Int                   @default(50)
  topCutExtraMinutes    Int                   @default(25)
  /// aucun | auto | 2 | 4 | 8 | 16 | 32
  topCutSetting         String                @default("aucun")
  swissRounds           Int                   @default(3)
  /// inscriptions | suisse | top_cut | termine | annule
  status                String                @default("inscriptions")
  registrationOpen      Boolean               @default(true)
  requireApproval       Boolean               @default(false)
  /// direct | organizer : validation d'un score confirmé sur le téléphone du déclarant
  oneDeviceMode         String                @default("direct")
  declareTimeoutMinutes Int                   @default(10)
  /// zero | loss : rondes manquées par un retardataire
  lateEntryPolicy       String                @default("zero")
  revision              Int                   @default(0)
  /// Tirage au sort d'une égalité au seuil du top cut (JSON), figé une fois effectué.
  cutDrawJson           String?
  /// Qualifiés du top cut (JSON : ids dans l'ordre de seed), figés à la fin des rondes suisses.
  cutJson               String?
  championId            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organizers            TournamentOrganizer[]
  invites               TournamentInvite[]
  players               TournamentPlayer[]
  rounds                TournamentRound[]
  actions               TournamentAction[]
}

model TournamentOrganizer {
  tournamentId String
  userId       String
  /// owner | co
  role         String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
}

/// Invitation de co-organisateur à usage unique (seule l'empreinte du jeton est stockée).
model TournamentInvite {
  id           String     @id @default(cuid())
  tournamentId String
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

/// Participant : inscrit par code (compte ou invité), créé par le TO (« papier ») ou récupéré
/// par QR personnel. `name` est une copie : il survit à la suppression du compte (SetNull).
model TournamentPlayer {
  id                String            @id @default(cuid())
  tournamentId      String
  userId            String?
  name              String
  /// Pseudo normalisé (sans casse, accents ni espaces superflus) : unicité par tournoi.
  nameKey           String
  /// pending | active | dropped | dq
  status            String            @default("active")
  dqReason          String?
  /// Première ronde à laquelle le joueur peut être apparié.
  joinedRound       Int               @default(1)
  /// Rondes suisses manquées (arrivée en retard, drop puis réintégration) : défaites si
  /// lateEntryPolicy = loss, sans effet sinon.
  missedRounds      Int               @default(0)
  /// Dernière ronde suisse jouée avant un drop / une DQ.
  droppedAfterRound Int?
  cutDeclined       Boolean           @default(false)
  deviceTokenHash   String?           @unique
  claimTokenHash    String?           @unique
  claimExpiresAt    DateTime?
  createdAt         DateTime          @default(now())
  tournament        Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchesAsA        TournamentMatch[] @relation("MatchPlayerA")
  matchesAsB        TournamentMatch[] @relation("MatchPlayerB")

  @@unique([tournamentId, nameKey])
  @@unique([tournamentId, userId])
  @@index([userId])
}

model TournamentRound {
  id              String            @id @default(cuid())
  tournamentId    String
  number          Int
  /// swiss | top_cut
  phase           String
  /// draft | published | running | closed
  status          String            @default("draft")
  startedAt       DateTime?
  durationSeconds Int
  pausedAt        DateTime?
  pausedSeconds   Int               @default(0)
  addedSeconds    Int               @default(0)
  createdAt       DateTime          @default(now())
  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches         TournamentMatch[]

  @@unique([tournamentId, number])
}

/// Match. `playerBId` nul = bye. Chaque joueur déclare dans sa propre case (declAJson /
/// declBJson) : deux déclarations simultanées ne s'écrasent jamais. `version` sert de verrou
/// optimiste pour toute écriture.
model TournamentMatch {
  id              String               @id @default(cuid())
  roundId         String
  table           Int
  /// Position dans l'arbre du top cut (0 = premier match du tour).
  bracketSlot     Int?
  playerAId       String
  playerBId       String?
  /// en_cours | declare | conteste | valide
  status          String               @default("en_cours")
  /// normal | bye | double_loss | id | no_show
  kind            String               @default("normal")
  gamesA          Int?
  gamesB          Int?
  declAJson       String?
  declBJson       String?
  declaredAt      DateTime?
  confirmedOnSite Boolean              @default(false)
  extraSeconds    Int                  @default(0)
  version         Int                  @default(0)
  updatedAt       DateTime             @updatedAt
  round           TournamentRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerA         TournamentPlayer     @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: NoAction)
  playerB         TournamentPlayer?    @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: NoAction)
  logs            TournamentMatchLog[]

  @@index([roundId])
  @@index([playerAId])
  @@index([playerBId])
}

/// Historique des modifications d'un résultat (auteur, ancien et nouveau score).
model TournamentMatchLog {
  id            String          @id @default(cuid())
  matchId       String
  actorUserId   String?
  actorPlayerId String?
  action        String
  beforeJson    String
  afterJson     String
  createdAt     DateTime        @default(now())
  match         TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

/// Commandes organisateur déjà appliquées : un renvoi de la file hors connexion avec le même
/// `clientActionId` renvoie le résultat enregistré au lieu d'agir deux fois.
model TournamentAction {
  tournamentId   String
  clientActionId String
  resultJson     String
  createdAt      DateTime   @default(now())
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@id([tournamentId, clientActionId])
}
